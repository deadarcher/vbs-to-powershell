---
/**
 * Minimal standalone layout for the open-source build.
 *
 * The hosted copies of these pages at getrff.com run inside the marketing site's own layout,
 * which carries site nav, analytics, and fonts this repo has no business shipping. This is the
 * stripped equivalent: enough <head> to be a real page, nothing that phones anywhere.
 *
 * NOTHING here loads a third-party resource. No analytics, no font CDN, no tag manager. That is
 * deliberate - the whole promise of these tools is that your file never leaves the machine, and
 * a self-hosted copy that quietly beacons somewhere would make a liar of that promise.
 */
interface Props {
  title?: string;
  description?: string;
  jsonLd?: unknown;
}
const {
  title = 'RFF free Windows tools',
  description = 'Free browser tools for Windows admins. Everything runs locally - nothing is uploaded.',
  jsonLd,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #FAFAF7;
    --surface: #FFFFFF;
    --surface-hover: #F5F4F0;
    --surface-alt: #F2F0E8;
    --ink: #13111C;
    --ink-2: rgba(19, 17, 28, 0.7);
    --ink-3: rgba(19, 17, 28, 0.5);
    --border: rgba(19, 17, 28, 0.08);
    --border-strong: rgba(19, 17, 28, 0.15);
    --brand: #5E42D6;
    --brand-light: #7C5CFF;
    --brand-bg: #F2EEFF;
    --brand-border: rgba(124, 92, 255, 0.3);
    --success: #3DAA6E;
    --success-bg: #E8F5EE;
    --warning: #D97706;
    --warning-bg: #FEF3E2;
    --danger: #DC2626;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    /* System stack on purpose: no webfont request, so the page works fully offline. */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { letter-spacing: -0.01em; }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.92em;
  }
  a { color: var(--brand); }
</style>
